GNANI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DATABASE_URL=postgresql://gnani:gnani@localhost:5432/audio_notes
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000

# Leave S3_BUCKET empty to store files in ./storage (local dev only)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=500

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FREE_UPLOAD_LIMIT=10
